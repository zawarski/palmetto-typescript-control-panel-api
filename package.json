    "@serverless/typescript": "^4.30.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/aws-param-store": "^3.2.4",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "esbuild": "^0.28.2",
